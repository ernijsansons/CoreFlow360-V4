# CoreFlow360 V4 - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application environment (development, staging, production)
NODE_ENV=development
ENVIRONMENT=development

# API Configuration
VITE_API_URL=http://127.0.0.1:8787
API_VERSION=v4
APP_NAME="CoreFlow360 V4"

# ============================================================================
# CLOUDFLARE WORKERS
# ============================================================================

# Cloudflare API Token (for wrangler CLI)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# JWT Secret (CRITICAL - use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_very_secure_jwt_secret_minimum_32_characters_long

# Auth Secret for additional security
AUTH_SECRET=your_auth_secret_here

# Encryption Key for sensitive data
ENCRYPTION_KEY=your_encryption_key_here

# ============================================================================
# AI SERVICES
# ============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL_PRIMARY=claude-3-sonnet
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000

# OpenAI API (optional)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_SECONDARY=gpt-4

# Agent System Configuration
AGENT_SYSTEM_ENABLED=true
MAX_AGENT_CONCURRENCY=10
AGENT_TIMEOUT_MS=30000

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Microsoft Clarity (privacy-compliant analytics)
VITE_CLARITY_ID=disabled  # Set to your Clarity ID or leave as 'disabled'

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# Telemetry API Key (for authenticated telemetry endpoints)
TELEMETRY_API_KEY=your_telemetry_api_key_here

# ============================================================================
# PAYMENT PROCESSORS
# ============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ============================================================================
# COMMUNICATION SERVICES
# ============================================================================

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@coreflow360.com

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8787

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_AI_FEATURES=true
ENABLE_CROSS_BUSINESS_INTELLIGENCE=true
ENABLE_PREDICTIVE_SCALING=true
ENABLE_AUTONOMOUS_OPERATIONS=true

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Enable verbose logging
VERBOSE_LOGGING=true

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit .env.local or .env files to version control
# 2. Use strong, unique secrets for production
# 3. Rotate secrets regularly
# 4. Use Cloudflare Secrets for sensitive values in production:
#    wrangler secret put JWT_SECRET
#    wrangler secret put ANTHROPIC_API_KEY
# 5. Frontend environment variables must be prefixed with VITE_
