{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.90 }],

        "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "interactive": ["error", { "maxNumericValue": 3800 }],
        "speed-index": ["error", { "maxNumericValue": 3400 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 409600 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 102400 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 614400 }],

        "uses-long-cache-ttl": "warn",
        "uses-optimized-images": "warn",
        "modern-image-formats": "warn",
        "offscreen-images": "warn",
        "unused-css-rules": "warn",
        "unused-javascript": "warn",
        "uses-text-compression": "error",
        "uses-responsive-images": "warn",
        "efficient-animated-content": "warn",
        "duplicated-javascript": "warn",
        "legacy-javascript": "warn",

        "font-display": "warn",
        "unminified-css": "error",
        "unminified-javascript": "error",

        "uses-rel-preconnect": "warn",
        "uses-rel-preload": "warn",
        "critical-request-chains": "warn",

        "mainthread-work-breakdown": ["warn", { "maxNumericValue": 4000 }],
        "bootup-time": ["warn", { "maxNumericValue": 3500 }],

        "redirects": "error",
        "uses-http2": "error",
        "viewport": "error",
        "document-title": "error",
        "meta-description": "warn",
        "link-text": "warn",
        "crawlable-anchors": "error",
        "robots-txt": "warn",
        "hreflang": "warn",
        "canonical": "warn",

        "errors-in-console": "warn",
        "no-document-write": "error",
        "uses-passive-event-listeners": "warn",
        "no-vulnerable-libraries": "error",
        "geolocation-on-start": "error",
        "notification-on-start": "error",
        "deprecations": "warn",
        "charset": "error",
        "no-unload-listeners": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  },
  "budgets": [
    {
      "path": "/*",
      "resourceSizes": [
        {
          "resourceType": "script",
          "budget": 400
        },
        {
          "resourceType": "stylesheet",
          "budget": 30
        },
        {
          "resourceType": "font",
          "budget": 50
        },
        {
          "resourceType": "image",
          "budget": 100
        },
        {
          "resourceType": "total",
          "budget": 600
        }
      ],
      "timings": [
        {
          "metric": "first-contentful-paint",
          "budget": 1800
        },
        {
          "metric": "largest-contentful-paint",
          "budget": 2500
        },
        {
          "metric": "interactive",
          "budget": 3800
        },
        {
          "metric": "cumulative-layout-shift",
          "budget": 0.1
        },
        {
          "metric": "total-blocking-time",
          "budget": 300
        }
      ]
    },
    {
      "path": "/pricing",
      "resourceSizes": [
        {
          "resourceType": "script",
          "budget": 350
        },
        {
          "resourceType": "stylesheet",
          "budget": 25
        },
        {
          "resourceType": "image",
          "budget": 80
        }
      ],
      "timings": [
        {
          "metric": "first-contentful-paint",
          "budget": 1500
        },
        {
          "metric": "largest-contentful-paint",
          "budget": 2200
        }
      ]
    },
    {
      "path": "/auth/login",
      "resourceSizes": [
        {
          "resourceType": "script",
          "budget": 250
        },
        {
          "resourceType": "stylesheet",
          "budget": 20
        }
      ],
      "timings": [
        {
          "metric": "first-contentful-paint",
          "budget": 1200
        },
        {
          "metric": "interactive",
          "budget": 3000
        }
      ]
    }
  ]
}
