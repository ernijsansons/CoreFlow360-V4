{
  "permissions": {
    "allow": [
      "Bash(if [ -z \"$ANTHROPIC_API_KEY\" ])",
      "Bash(then echo \"NOT_SET\")",
      "Bash(else echo \"API_KEY_EXISTS\")"
    ],
    "deny": [],
    "ask": []
  },
  "mcpServers": {
    "TalkToFigma": {
      "command": "bunx",
      "args": [
        "cursor-talk-to-figma-mcp@latest"
      ]
    },
    "ClaudeCodeFigma": {
      "command": "bunx",
      "args": [
        "claude-talk-to-figma-mcp@latest"
      ]
    }
  }
}