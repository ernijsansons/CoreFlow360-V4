  "accessibilityChecklist": [
    {
      "category": "Visual",
      "items": [
        "All text meets WCAG AAA contrast ratios (7:1 normal, 4.5:1 large)",
        "Focus indicators visible and high contrast",
        "Images have descriptive alt text",
        "Color not sole indicator of meaning",
        "Responsive text sizing without horizontal scroll"
      ]
    },
    {
      "category": "Keyboard",
      "items": [
        "All interactive elements keyboard accessible",
        "Logical tab order throughout page",
        "Skip navigation links provided",
        "No keyboard traps",
        "Keyboard shortcuts documented"
      ]
    },
    {
      "category": "Screen Readers",
      "items": [
        "ARIA labels for all interactive elements",
        "Semantic HTML structure (headings, landmarks)",
        "Form labels properly associated",
        "Error messages announced",
        "Dynamic content updates announced"
      ]
    },
    {
      "category": "Motion",
      "items": [
        "Respect prefers-reduced-motion",
        "Pause controls for auto-playing content",
        "No seizure-inducing animations",
        "Smooth scroll can be disabled",
        "Essential animations only"
      ]
    },
    {
      "category": "Cognitive",
      "items": [
        "Clear, simple language",
        "Consistent navigation patterns",
        "Error prevention and recovery",
        "Progress indicators for multi-step processes",
        "Help available throughout"
      ]
    }
  ],

